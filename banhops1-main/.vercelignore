# Ignore large source and project directories
.dart_tool/
.vscode/
android/
ios/
windows/
macos/
linux/
lib/
test/
scratch/
supabase/


# Ignore everything inside build directory
build/*
# Except build/web
!build/web
!build/web/**

# Ignore root level files not needed for static deployment
*.sql
*.patch
*.log
*.lock
*.yaml
*.md
.env
.env.example
.gitignore
.metadata
.flutter-plugins-dependencies
.last_build_id
